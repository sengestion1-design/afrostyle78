Options -MultiViews

# Block direct access to sensitive directories
<IfModule mod_rewrite.c>
RewriteEngine On
# Pas de RewriteBase fixe : "/" ne vaut qu'en production, ou le site occupe la
# racine du domaine. En local sous XAMPP il vit dans /afrostyle/, et un
# RewriteBase / y cassait toutes les URL propres (/suivi, /boutique...).
# Sans directive, Apache deduit le bon prefixe du dossier du .htaccess.
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^vendor/ - [F,L]
</IfModule>

# Block access to sensitive file types
<FilesMatch "\.(env|log|sql|bak|sh)$">
    Require all denied
</FilesMatch>

# Rediriger les accès directs .php vers URL propre (hors admin/)
# UNIQUEMENT sur les requêtes GET : une redirection 301 sur un POST
# perd le corps de la requête (casse l'ajout au panier, les webhooks, le checkout AJAX).
# On exclut aussi explicitement les endpoints techniques (AJAX / webhooks).
# THE_REQUEST est la ligne brute envoyee par le navigateur ("GET /suivi.php HTTP/1.1").
# Contrairement a REQUEST_URI, elle n'est pas modifiee par les reecritures internes :
# une URL propre deja reecrite vers .php ne redeclenche donc pas cette regle
# (sinon /suivi -> suivi.php -> /suivi -> ... en boucle infinie).
# Le groupe capture le chemin complet depuis la racine du serveur, prefixe inclus,
# ce qui vaut aussi bien en local (/afrostyle/suivi) qu'en production (/suivi).
RewriteCond %{REQUEST_METHOD} =GET
# THE_REQUEST est la ligne brute du navigateur ("GET /cgv.php HTTP/1.1"), que les
# reecritures internes ne modifient pas : une URL propre deja reecrite vers .php
# ne redeclenche donc pas cette regle (sinon /cgv -> cgv.php -> /cgv, en boucle).
# Le groupe capture tout le chemin, prefixe de sous-dossier compris, et fonctionne
# a la racine du domaine (/cgv.php) comme en local (/afrostyle/cgv.php).
RewriteCond %{THE_REQUEST} \s(/(?:[^\s?]*/)?)(?!admin/)([^./\s?]+)\.php[\s?] [NC]
RewriteCond %{THE_REQUEST} !\s/(?:[^\s?]*/)?admin/ [NC]
RewriteCond %2 !^(cart-action|paydunya-webhook|wave-webhook|paydunya-success|wave-success|stripe-success|paypal-checkout|paypal-success)$ [NC]
RewriteRule \.php$ %1%2 [R=301,L]

# Réécrire les URLs propres vers .php (liste explicite)
RewriteRule ^boutique$ boutique.php [NC,L]
RewriteRule ^produit$ produit.php [NC,L]
RewriteRule ^panier$ panier.php [NC,L]
RewriteRule ^commande$ commande.php [NC,L]
RewriteRule ^confirmation$ confirmation.php [NC,L]
RewriteRule ^suivi$ suivi.php [NC,L]
RewriteRule ^sur-mesure$ sur-mesure.php [NC,L]
RewriteRule ^login$ login.php [NC,L]
RewriteRule ^logout$ logout.php [NC,L]
RewriteRule ^register$ register.php [NC,L]
RewriteRule ^compte$ compte.php [NC,L]
RewriteRule ^stripe-checkout$ stripe-checkout.php [NC,L]
RewriteRule ^stripe-success$ stripe-success.php [NC,L]
RewriteRule ^paydunya-checkout$ paydunya-checkout.php [NC,L]
RewriteRule ^paydunya-success$ paydunya-success.php [NC,L]
RewriteRule ^paydunya-webhook$ paydunya-webhook.php [NC,L]
RewriteRule ^cart-action$ cart-action.php [NC,L]
RewriteRule ^wave-checkout$ wave-checkout.php [NC,L]
RewriteRule ^wave-success$ wave-success.php [NC,L]
RewriteRule ^wave-webhook$ wave-webhook.php [NC,L]
RewriteRule ^paypal-checkout$ paypal-checkout.php [NC,L]
RewriteRule ^paypal-success$ paypal-success.php [NC,L]
RewriteRule ^mot-de-passe-oublie$ mot-de-passe-oublie.php [NC,L]
RewriteRule ^politique-confidentialite$ politique-confidentialite.php [NC,L]
RewriteRule ^guide-des-tailles$ guide-des-tailles.php [NC,L]
RewriteRule ^cgv$ cgv.php [NC,L]
RewriteRule ^mentions-legales$ mentions-legales.php [NC,L]

# Pages d'erreur personnalisées
# erreur.php est autonome (aucun require, aucune requete SQL) : il doit
# pouvoir s'afficher meme quand PHP ou MySQL est en panne.
ErrorDocument 404 /404.php
ErrorDocument 400 /erreur.php
ErrorDocument 403 /erreur.php
ErrorDocument 500 /erreur.php
ErrorDocument 503 /erreur.php
